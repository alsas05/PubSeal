# =============================================================
# PubSeal Master Git Ignore
# Protects all confidential credentials, secrets, vaults, and assets
# =============================================================

# 1. Environment Secrets & API Keys (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
credentials.json
client_secret*.json

# 2. Node Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. User Uploads & Author Vault Manuscripts (CONFIDENTIAL)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
*/uploads/*
!*/uploads/.gitkeep

# 4. Local Database Backups & Temporary Exports
backend/backups/
backups/
*.bson
*.dump

# 5. Scratch & Debug Scripts
backend/scratch/
scratch/

# 6. Production Build Artifacts
dist/
frontend/dist/
admin/dist/
build/

# 7. OS & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Logs & Coverage
logs/
*.log
coverage/
.system_generated/
