# PubSeal Environment Configuration Template
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/pubseal
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# =============================================================
# REAL EMAIL DELIVERY CONFIGURATION (SMTP)
# =============================================================
# Option A: Gmail SMTP
# Generate an App Password in Google Account > Security > App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="PubSeal Registry" <your_email@gmail.com>

# Option B: Custom SMTP (SendGrid, Brevo, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
